# Supabase (for client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Functions (server-side) / Lovable AI key
# Set this in your Supabase Functions environment (not in client-side .env)
LOVABLE_API_KEY=your_lovable_api_key

# Optional: set a server-side API key for your own backend (if used)
# API_KEY=...
